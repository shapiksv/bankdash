# Optional overrides for docker-compose.yml. Copy to .env and edit.
# Every value below is already the default, so .env is not required.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Host port of Kafka's EXTERNAL listener (advertised as localhost:<port>).
KAFKA_EXTERNAL_PORT=9092

KAFKA_UI_PORT=8090
